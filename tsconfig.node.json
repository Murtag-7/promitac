{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/core/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.electron.config.ts",
    "config/**/*.ts"
  ]
}
