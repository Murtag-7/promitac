{
  "title": "Světlo nad údolím",
  "style": "serif",
  "pdf": true,
  "stanzas": [
    {
      "marker": "1.",
      "lines": [
        "[G]Ráno když se pro[D]bouzí kra[Emi]jina ti[C]chá,",
        "nad [G]lesem se roz[D]lévá světlo jak [G]řeka,",
        "[Emi]ptáci zpívají [Ami]písně všemu, co [D]dýchá,",
        "a [C]celé údolí s na[D7]dějí čeká.[G]"
      ]
    },
    {
      "marker": "R:",
      "lines": [
        "[C]Zář nad námi, [G]světlo věčné,",
        "[Ami]prosvěť cesty, [D/Fis]které jsou temné,",
        "[C]ať se srdce [G]naše ne[Emi]bojí,",
        "když nás [Ami]tvoje [D]láska ob[G]jímá."
      ]
    },
    {
      "marker": "2.",
      "lines": [
        "[G]Večer když se [D]stmívá nad [Emi]střechami [C]měst,",
        "lampy [G]pomalu hasnou a [D]ztichne i [G]hlas,",
        "v [Emi]duši zůstává [Ami]klid jako hvězdná [D]cesta,",
        "a [C]víra, že zítra [D7]probudíš [G]nás."
      ]
    }
  ]
}
