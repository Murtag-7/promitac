  "intro": { "label": "Předehra:", "chords": ["G", "C", "D", "G"] },
  "stanzas": [
    {
      "marker": "1.",
      "lines": [
        "Jdu po [G]kamenité stezce [C]do hor,",
        "[G]batoh mám těžký a [D]nohy už bolí,",
        "[Emi]přesto mě vede tvůj [C]tichý hlas,",
        "jako by [D]šeptal: neboj se, [G]dojdeš."
      ]
    },
    {
      "marker": "R:",
      "lines": [
        "[C]Krok za krokem, [G]den za dnem,",
        "[C]s tebou se nebojím [D]jít dál,",
        "[Emi]i když je noc a [Hmi]vítr duje,",
        "[C]ty jsi můj [Dsus4]štít i můj [D]hrad."
      ]
    },
    {
      "marker": "2.",
      "lines": [
        "[G]Potoky zurčí a [C]skály se tyčí,",
        "na [G]nebi krouží orel [D]nad lesem,",
        "[Emi]žízeň mi hasí [C]pramen čistý,",
        "a já ti [D]děkuji [G]zpěvem."
      ]
    }
  ]
