{
  "name": "promitac",
  "productName": "Promítač",
  "version": "0.1.0",
  "description": "Promítací aplikace pro církve – písně, plán bohoslužby, Bible, média.",
  "author": "Promítač",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "electron-vite dev",
    "predev:web": "npm run prepare-assets",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "npm run prepare-assets",
    "build": "electron-vite build",
    "prebuild:web": "npm run prepare-assets",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ocr": "vitest run --project ocr --passWithNoTests",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test -c playwright.config.ts",
    "pretest:electron": "npm run build",
    "test:electron": "xvfb-run -a -s \"-screen 0 1920x1080x24\" playwright test -c playwright.electron.config.ts",
    "screenshots": "npm run build:web && playwright test -c playwright.config.ts tests/e2e/screenshots.spec.ts",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux-dir": "npm run build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/source-sans-3": "^5.3.1",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/ces": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "docx": "^9.14.0",
    "electron": "44.9.3",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
